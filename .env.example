# ==========================================================================
# LAMINAR / Kandace — variables de entorno del BACKEND (AWS Lambda o dev local)
# Copia a `.env` para desarrollo, o pásalas como parámetros del deploy (SAM).
# NO pongas valores reales aquí. `.env` está en `.gitignore`.
# El agente de escritorio NO usa este archivo (usa kandace.settings.json).
# El frontend NO usa secretos (solo valores públicos).
# ==========================================================================

# ----------------------- Aplicación / interruptores ----------------------
AWS_REGION=us-east-1              # Región AWS. Obligatoria en deploy.
BEDROCK_ENABLED=false            # true habilita Bedrock. Mantener false salvo deploy supervisado.
KILL_SWITCH=false                # true corta TODAS las llamadas al LLM (freno de emergencia).

# ---------------------- Inteligencia artificial (proveedor) ---------------
# Prioridad de selección: DeepSeek > Anthropic > Bedrock > mock (local).
# DeepSeek (API compatible con OpenAI). Key en https://platform.deepseek.com
DEEPSEEK_API_KEY=                # SECRETO. Vacío = no usar DeepSeek. Formato: sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-chat     # Opcional. Por defecto deepseek-chat.
# Anthropic directo (alternativa). Key en https://console.anthropic.com
ANTHROPIC_API_KEY=               # SECRETO. Vacío = no usar Anthropic. Formato: sk-ant-xxxx
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # Opcional. Modelo de la API de Anthropic.
# Bedrock (solo si BEDROCK_ENABLED=true)
BEDROCK_MODEL_ID=                # modelId confirmado en consola. Vacío mientras no aplique.

# ------------------------- FinOps: presupuesto ----------------------------
MAX_CALLS_PER_HOUR=20            # Tope de invocaciones al LLM por hora (ServerBudgetGate).
MAX_CALLS_PER_DAY=100            # Tope por día.
MAX_OUTPUT_TOKENS=180            # Máx. tokens de salida por decisión.
DECISION_TTL_SECONDS=20          # Vigencia de una decisión.

# ------------- Gate de códigos de prueba (tope de gasto por usuario) -------
TRIAL_CODES_TABLE=               # Tabla DynamoDB de códigos. Vacío = gate DESACTIVADO.
TRIAL_MAX_CALLS=400              # Tope de llamadas a la IA por código (~US$0.50). Configurable.

# ---------------------- Umbrales de decisión (fricción) -------------------
FRICTION_THRESHOLD=0.78          # Umbral del score de fricción.
SUSTAINED_WINDOWS=4              # Ventanas sostenidas requeridas (~3s c/u).
MIN_OBSERVATION_MINUTES=3
DECISION_COOLDOWN_MINUTES=15
RECOVERY_COOLDOWN_MINUTES=30
MAX_RECOVERY_DURATION_SECONDS=60
DECISION_TTL_SECONDS=20

# ---------------- Capa de aprendizaje local (opt-in, ADR-017) -------------
LEARNING_ENABLED=false
LEARNING_MIN_SAMPLES=5

# ------------------------ Persistencia (DynamoDB) -------------------------
AGGREGATES_TABLE=                # Tabla de agregados de equipo. Vacío = memoria (solo dev).

# ==========================================================================
# DESKTOP (solo referencia — el agente lee kandace.settings.json, no .env):
#   apiBaseUrl · apiKey (API Gateway) · trialCode · sensors (real|sim) · ui (v1|v2)
#   Equivalentes por entorno: LAMINAR_API_BASE_URL, LAMINAR_API_KEY,
#   LAMINAR_TRIAL_CODE, LAMINAR_SENSORS, LAMINAR_UI
# ==========================================================================
