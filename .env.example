# Región y modelo (NO fijar el modelo hasta cerrar F0-03; ver ADR-002)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Interruptores maestros (deben permanecer así en trabajo autónomo)
BEDROCK_ENABLED=false
KILL_SWITCH=false

# Presupuesto del servidor (ServerBudgetGate)
MAX_CALLS_PER_HOUR=20
MAX_CALLS_PER_DAY=100
MAX_OUTPUT_TOKENS=180

# Umbrales de decisión (provisionales, ver LAMINAR_FINOPS_ARCHITECTURE.md)
FRICTION_THRESHOLD=0.78
SUSTAINED_WINDOWS=3
MIN_OBSERVATION_MINUTES=3
DECISION_COOLDOWN_MINUTES=15
RECOVERY_COOLDOWN_MINUTES=30
MAX_RECOVERY_DURATION_SECONDS=60
DECISION_TTL_SECONDS=20

# Capa de aprendizaje local (ADR-017); opt-in, por defecto desactivada
LEARNING_ENABLED=false
LEARNING_MIN_SAMPLES=5

# Endpoint (tras despliegue supervisado)
API_BASE_URL=https://example.execute-api.region.amazonaws.com
# Persistencia posterior (no usada en el MVP local)
METRICS_TABLE_NAME=laminar-metrics
FEEDBACK_TABLE_NAME=laminar-feedback
