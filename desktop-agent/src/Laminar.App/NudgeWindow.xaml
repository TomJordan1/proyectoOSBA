<Window x:Class="Laminar.App.NudgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanny" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <!-- Aviso con anillo de cuenta regresiva (8 s). Poco texto. Botones rectangulares
         con bordes redondeados. Al completarse el círculo entra la pausa (salvo Cancelar). -->
    <Window.Resources>
        <Style x:Key="RectBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Width="300" CornerRadius="18" Padding="22,18" Margin="14"
            BorderBrush="#2E78E1EB" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F00B1620" Offset="0"/>
                <GradientStop Color="#F0060D15" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Msg" Text="La pantalla se bloqueará en:" Foreground="#F5FBFF"
                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>

            <!-- Anillo de cuenta regresiva -->
            <Canvas Width="100" Height="100" HorizontalAlignment="Center" Margin="0,14,0,6">
                <Ellipse Width="80" Height="80" Canvas.Left="10" Canvas.Top="10"
                         Stroke="#20FFFFFF" StrokeThickness="6"/>
                <Path x:Name="Arc" Stroke="#36E6EE" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <TextBlock x:Name="Count" Canvas.Left="0" Canvas.Top="30" Width="100" TextAlignment="Center"
                           Text="6" Foreground="#EAFDFF" FontSize="30" FontWeight="Bold"/>
            </Canvas>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="Cancelar" Click="OnDecline" Style="{StaticResource RectBtn}"
                        Margin="0,0,8,0" Foreground="#CFE4EB" Background="#14FFFFFF"/>
                <Button Content="Pausar ahora" Click="OnAccept" Style="{StaticResource RectBtn}"
                        Foreground="#04121A" FontWeight="SemiBold" Background="#36E6EE"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
