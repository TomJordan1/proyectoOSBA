<Window x:Class="Laminar.App.RecoveryOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Laminar.App"
        Title="Pausa activa" WindowStyle="None" AllowsTransparency="False"
        Background="#030711" WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" Focusable="True" KeyDown="OnKeyDown">
    <Grid>
        <!-- Escena de fondo: radial verdoso, corrientes, partículas y efecto sonar.
             Empieza translúcida (0.2) y sube poco a poco hasta ~0.8 (nunca 100%). -->
        <local:PauseScene x:Name="Scene" Opacity="0.2"/>

        <!-- Kanny centrado, respira (escala) con el ritmo -->
        <local:KannyView x:Name="Kanny" Width="420" Height="420" BaseRadius="140"
                         ParticleCount="30" TargetFps="30"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
            <local:KannyView.RenderTransform>
                <ScaleTransform x:Name="KannyScale" ScaleX="1" ScaleY="1"/>
            </local:KannyView.RenderTransform>
        </local:KannyView>

        <!-- Capa de UI -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mensaje (marco con borde cyan, como el diseño) -->
            <Border Grid.Row="0" HorizontalAlignment="Center" MaxWidth="760" Margin="0,44,0,0"
                    CornerRadius="22" Padding="30,20,30,18"
                    BorderBrush="#2E78E1EB" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8C050F17" Offset="0"/>
                        <GradientStop Color="#55030910" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="Msg" Text="Relaja los hombros y respira hondo tres veces."
                               Foreground="#F5FBFF" FontSize="30" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Sub" Text="Sigue el ritmo de Kanny. Puedes salir cuando quieras."
                               Foreground="#9DB8C4" FontSize="15" Margin="0,10,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Tarjeta de estado (pill: punto + fase + cuenta + salir) -->
            <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,36"
                    CornerRadius="14" Padding="16,9" Background="#40020910"
                    BorderBrush="#0EFFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#36E6EE" VerticalAlignment="Center">
                        <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="Phase" Text="Inhala" Foreground="#DFFEFF" FontWeight="SemiBold"
                               MinWidth="66" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Countdown" Text="01:30" Foreground="#66AEC4CC" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Salir · Esc" Click="OnExit" Margin="16,0,0,0" Padding="13,7"
                            Foreground="#CCE4EB" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="999" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1CFFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="Laminar · pausa activa" Foreground="#6BB4C2C8" FontSize="11"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14"/>
    </Grid>
</Window>
