<Window x:Class="Laminar.App.RecoveryOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperación" WindowStyle="None" AllowsTransparency="True"
        Background="#CC0F1420" WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" Focusable="True" KeyDown="OnKeyDown">
    <Grid>
        <Canvas x:Name="BubbleCanvas"/>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,60,0,0">
            <TextBlock x:Name="Msg" Text="Respira un momento." Foreground="#E6EDF3" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Hint" Text="Toca las burbujas o pulsa Esc para salir" Foreground="#8B98A5" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
        <Button Content="Salir" Click="OnExit" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"/>
    </Grid>
</Window>
