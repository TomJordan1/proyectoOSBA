<Window x:Class="Laminar.App.RecoveryOverlayV2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Laminar.App"
        Title="Pausa activa (V2)" WindowStyle="None" AllowsTransparency="False"
        Background="#030711" WindowState="Maximized" Topmost="True"
        ShowInTaskbar="False" Focusable="True" KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="ChoiceButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DFFCFF"/>
            <Setter Property="Background" Value="#1147E9EF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="999" Background="{TemplateBinding Background}"
                                BorderBrush="#2C6FEAEE" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2247E9EF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón "Salir" con forma de logout: rectángulo redondeado + ícono + texto. -->
        <Style x:Key="ExitButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DFFCFF"/>
            <Setter Property="Background" Value="#1C47E9EF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="#3C6FEAEE" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E47E9EF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fondo (mismo que V1) -->
        <local:PauseScene x:Name="Scene" Opacity="0.2"/>

        <!-- Kanny centrado, respira con el ritmo -->
        <local:KannyView x:Name="Kanny" Width="420" Height="420" BaseRadius="140"
                         ParticleCount="30" TargetFps="30"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
            <local:KannyView.RenderTransform>
                <ScaleTransform x:Name="KannyScale" ScaleX="1" ScaleY="1"/>
            </local:KannyView.RenderTransform>
        </local:KannyView>

        <!-- Zona clicable sobre Kanny (para responderle) -->
        <Ellipse x:Name="KannyHit" Width="330" Height="330" Fill="Transparent" Cursor="Hand"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 MouseLeftButtonDown="OnKannyClick"/>

        <!-- Barra superior: rectángulo con esquinas redondeadas (no óvalo). -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0"
                CornerRadius="14" Padding="16,9" Background="#8C030A11" BorderBrush="#10FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#47E9EF" VerticalAlignment="Center">
                    <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="Phase" Text="Inhala" Foreground="#E8FFFF" FontWeight="SemiBold"
                           MinWidth="66" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Countdown" Text="01:30" Foreground="#66AEC4CC" FontSize="12"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button Click="OnExit" Margin="16,0,0,0" Style="{StaticResource ExitButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Salir" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Globo de diálogo (Kanny habla) -->
        <StackPanel x:Name="DialogueRoot" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,120,0,0" MaxWidth="480" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.92" ScaleY="0.92"/>
                    <TranslateTransform x:Name="BubbleShift" Y="18"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <Border CornerRadius="26,26,26,8" Padding="20,16,22,16" BorderBrush="#406FEAEE" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EF091B27" Offset="0"/>
                        <GradientStop Color="#EA040D16" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="KANNY" Foreground="#72EEF0" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="LineText" Foreground="#F4FDFF" FontSize="20" TextWrapping="Wrap"
                               Margin="0,7,0,0" MinHeight="56"/>
                    <WrapPanel x:Name="Choices" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Text="Haz clic en Kanny para responderle" Foreground="#7AB5D2DC" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22"/>
    </Grid>
</Window>
